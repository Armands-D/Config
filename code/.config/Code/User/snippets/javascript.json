      "\ti ++",
      "}",
    ],
    "description": "While Less Than Array"
  },
  "JS if name == main": {
    "prefix": ["if-name-main", "main"],
    "body": [
      "function main(){",
      "\t$0",
      "}",
      "",
      "if (typeof require !== 'undefined' && require.main === module) {",
      "  main()",
      "}",
    ],
    "description": "JS if name == main"
  },
