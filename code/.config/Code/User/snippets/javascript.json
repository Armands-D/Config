{
  "For Of Loop": {
    "prefix": ["for", "for-each", "for-of"],
    "body": [
      "for(const ${2:element} of ${1:array}){",
      "\t$0",
      "}",
    ],
    "description": "A for of loop."
  },
  "While < Arr": {
    "prefix": ["while", "while-lt", "while-lt-arr"],
    "body": [
      "let i = 0",
